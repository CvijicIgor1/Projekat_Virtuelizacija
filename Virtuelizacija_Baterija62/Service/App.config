<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0"
                      sku=".NETFramework,Version=v4.7.2" />
  </startup>
    <appSettings>
      <add key="DataSetPath" value="..\..\..\Dataset\B01\EIS measurements\Test_1\Hioki" />
      <add key="ServiceDataLogPath" value="..\..\..\Data" />
	  <add key="DataOutputPath" value="..\..\..\Data" />
	  <add key="WarningLogPath" value="..\..\..\Data\warnings.log"/>
      <add key="V_threshold" value="0.05"/>
      <add key="Z_threshold" value="0.1"/>
      <add key="Odstupanje" value="25"/>
      <add key="T_threshold" value="3.0"/>
    </appSettings>
  <system.serviceModel>
    <services>
      <service name="Service.BatteryService">
        <host>
          <baseAddresses>
            <add baseAddress="net.tcp://localhost:4002" />
          </baseAddresses>
        </host>
        <endpoint
          address="BatteryLibrary"
          binding="netTcpBinding"
          contract="Common.IBatteryService" />
      </service>

    </services>
    <bindings>
      <netTcpBinding>
        <binding name="netTcpConfig"
                 transferMode="Streamed"
                 maxReceivedMessageSize="67000000"
                 sendTimeout="00:05:00"
                 receiveTimeout="00:5:00"
                 openTimeout="00:03:00"
                 closeTimeout="00:03:00" />
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
</configuration>